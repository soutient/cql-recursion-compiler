cabal-version:       2.4
name:                cql-recursion-compiler
version:             0.1.0.0
synopsis:            Zero-allocation CQL to SQL compiler using recursion schemes.
license:             BSD-3-Clause
author:              Alexis Soutient
maintainer:          retablies@hotmail.com
category:            Database, Compiler
build-type:          Simple

executable cql-compiler
  main-is:             Main.hs
  other-modules:       CQL.Core
                     , CQL.Optimizer
                     , CQL.SQL
  hs-source-dirs:      src
  default-language:    Haskell2010
  ghc-options:         -Wall -O2 -rtsopts
  build-depends:       base >= 4.14 && < 5
                     , containers >= 0.6


